# Switch main service
SERVER_PORT=8080

# Database (required)
DB_HOST=localhost
DB_PORT=5432
DB_NAME=banquito_db
DB_USER=banquito_user
DB_PASSWORD=banquito_password
APP_DB_ADMIN_DB=postgres

# JPA / Hibernate (required)
JPA_SHOW_SQL=false
JPA_DDL_AUTO=validate

# Database bootstrap control (required)
APP_DB_AUTO_CREATE=true

# Business rules
APP_INGEST_CUTOFF_HOUR=18
APP_VALIDATION_DUPLICATE_WINDOW_DAYS=30
APP_CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
APP_CORE_BASE_URL=http://localhost:8080
APP_CORE_CALENDAR_IS_BUSINESS_DAY_ENDPOINT=/api/holidays/is-business-day
