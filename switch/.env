# Variables de entorno para Switch Principal
# Copia este archivo a .env y ajusta según tu entorno

# ===== SERVIDOR =====
SERVER_PORT=8080
SPRING_PROFILES_ACTIVE=dev

# ===== BASE DE DATOS =====
DB_HOST=localhost
DB_PORT=5432
DB_NAME=banquito_db
DB_USER=banquito_user
DB_PASSWORD=banquito_password
SPRING_DATASOURCE_URL=jdbc:postgresql://${DB_HOST}:${DB_PORT}/${DB_NAME}
SPRING_DATASOURCE_USERNAME=${DB_USER}
SPRING_DATASOURCE_PASSWORD=${DB_PASSWORD}

# ===== PROCESAMIENTO DE ARCHIVOS =====
FILE_UPLOAD_MAX_SIZE=10MB
FILE_PROCESSING_ENABLED=true

# ===== HORARIO DE CORTE =====
CUTOFF_TIME=16:00
CUTOFF_TIMEZONE=America/Guayaquil

# ===== LOGGING =====
LOGGING_LEVEL_ROOT=INFO
LOGGING_LEVEL_EC_EDU_ESPE_BANQUITO=DEBUG

# ===== ACTUATOR =====
MANAGEMENT_ENDPOINTS_WEB_EXPOSURE_INCLUDE=health,info,metrics
MANAGEMENT_ENDPOINT_HEALTH_SHOW_DETAILS=always

# ===== EMAIL PROCESSOR (SFTP) =====
EMAIL_PROCESSOR_INPUT_DIR=./sftp-email
EMAIL_PROCESSOR_PROCESSED_DIR=./sftp-email/processed
EMAIL_PROCESSOR_ERROR_DIR=./sftp-email/errors
EMAIL_PROCESSOR_SCAN_INTERVAL=30s
EMAIL_PROCESSOR_ENABLED=true
